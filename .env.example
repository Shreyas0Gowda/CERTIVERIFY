# ===================================================
# CERTIVERIFY CONFIGURATION TEMPLATE
# ===================================================

# Backend API Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=certiverify_jwt_super_secret_key_2026

# MongoDB Connection
# If MongoDB is not running locally, CertiVerify automatically activates
# a robust embedded fallback store so the system runs 100% out-of-the-box.
MONGODB_URI=mongodb://127.0.0.1:27017/certiverify

# Blockchain RPC Configuration
# Local Hardhat Node RPC URL
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545

# Hardhat Chain ID
CHAIN_ID=31337

# Frontend Configuration
VITE_API_URL=http://localhost:5000

