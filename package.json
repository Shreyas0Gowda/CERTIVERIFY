{
  "name": "certiverify-root",
  "version": "1.0.0",
  "description": "CertiVerify - Blockchain-Based Certificate Verification System",
  "scripts": {
    "node": "cd blockchain && npx hardhat node",
    "deploy": "cd blockchain && npx hardhat run scripts/deploy.js --network localhost",
    "test:blockchain": "cd blockchain && npx hardhat test",
    "test:e2e": "cd blockchain && npx hardhat run ../scripts/testEndToEnd.js",
    "generate:certs": "node scripts/generateCertificates.js",
    "backend": "cd backend && npm start",
    "frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm run build"
  }
}

